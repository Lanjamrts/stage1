# Configuration SIGBD Backend
# Copiez ce fichier vers .env et adaptez les valeurs

# Environnement (development, production, test)
NODE_ENV=development

# Base de données MongoDB
# Requis sauf si CORE_STORE, REFERENCE_STORE et AUDIT_STORE valent tous 'oracle' :
# dans ce cas la ligne peut rester vide ou être retirée (si elle est renseignée,
# elle doit rester une URL valide). Le serveur ne se connecte à MongoDB que si un
# stockage en a besoin.
MONGODB_URI=mongodb://127.0.0.1:27017/sigbd

# Port du serveur API
PORT=4000

# Secret JWT (min 32 caractères, OBLIGATOIRE en production, ne pas utiliser la valeur par défaut)
JWT_SECRET=votre-secret-jwt-d-au-moins-32-caracteres-ici

# Délai d'inactivité de la session en minutes (glissant)
SESSION_TIMEOUT_MINUTES=30

# Origine CORS autorisée (ex: https://votre-domaine.com)
# CORS_ORIGIN=https://votre-domaine.com

# Faire confiance aux en-têtes de proxy (X-Forwarded-For, etc.) si derrière un reverse proxy
TRUST_PROXY=false

# Taille max du corps JSON en KB (défaut: 2048 KB = 2 MB, pour recensements et gabarits volumineux)
# JSON_BODY_LIMIT_KB=2048

# Fenêtre de rate limiting par utilisateur en minutes (défaut: 15)
# RATE_LIMIT_WINDOW_MINUTES=15

# Nombre max de requêtes par utilisateur par fenêtre (défaut: 1200)
# RATE_LIMIT_USER_MAX=1200

# Fenêtre de rate limiting pour login en minutes (défaut: 5)
# LOGIN_RATE_LIMIT_WINDOW_MINUTES=5

# Nombre max de tentatives de login par IP par fenêtre (défaut: 60)
# LOGIN_RATE_LIMIT_MAX=60

# Mot de passe de démo pour le seed (défaut: Test@2026 hors production)
# SEED_DEMO_PASSWORD=Test@2026

# Autorise le seed de DEMONSTRATION en production (DANGER : supprime des donnees). Laisser absent en production.
# SEED_ALLOW_PRODUCTION=true

# Dossier des CSV d'initialisation (defaut : backend/data/init)
# INIT_DATA_DIR=

# Base Oracle XE 21c (optionnelle : l'application fonctionne sur MongoDB sans ces variables)
# ORACLE_USER=sigbd
# ORACLE_PASSWORD=votre-mot-de-passe-oracle-ici
# ORACLE_CONNECT_STRING=127.0.0.1:1521/XEPDB1
# ORACLE_POOL_MIN=1
# ORACLE_POOL_MAX=10

# Variables Oracle de test (lues uniquement quand NODE_ENV=test)
# ORACLE_TEST_USER=sigbd_test
# ORACLE_TEST_PASSWORD=votre-mot-de-passe-oracle-test-ici
# ORACLE_TEST_CONNECT_STRING=127.0.0.1:1521/XEPDB1