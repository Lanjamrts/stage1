{
  "name": "sigbd-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SIGBD backend - API REST (Ministère de l'Économie et des Finances, DGBF / SSEBF)",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/demo.js",
    "seed:demo": "node src/seed/demo.js",
    "seed:ref": "node src/seed/reference.js",
    "init:structures": "node src/scripts/init-structures.js",
    "init:epn": "node src/scripts/init-epn.js",
    "init:periodes": "node src/scripts/init-periodes.js",
    "archive": "node src/scripts/archive.js",
    "create-admin": "node src/scripts/create-admin.js",
    "backup": "node src/scripts/backup.js",
    "restore": "node src/scripts/restore.js",
    "backup:verify": "node src/scripts/verify-backup.js",
    "test": "npm run seed:test && vitest run",
    "seed:test": "NODE_ENV=test MONGODB_URI=mongodb://127.0.0.1:27017/sigbd_test node src/seed/demo.js --yes --purge-audit"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "pdfkit": "^0.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.1"
  }
}
